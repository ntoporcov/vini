require "shellwords"
require "fileutils"

default_platform(:mac)

platform :mac do
  repo_root = File.expand_path("..", __dir__)

  def xcodegen_generate_command(repo_root)
    local_override = File.join(repo_root, "project.local.yml")
    include_local = File.exist?(local_override) ? "INCLUDE_PROJECT_LOCAL_YAML=1 " : ""
    "cd #{repo_root.shellescape} && #{include_local}/opt/homebrew/bin/xcodegen generate"
  end

  # App Store Connect API key — also used by notarytool for notarization.
  def asc_api_key
    key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"]
    issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"]
    key_content = ENV["APP_STORE_CONNECT_API_KEY_CONTENT"]&.strip
    key_filepath = ENV["APP_STORE_CONNECT_API_KEY_PATH"]&.strip

    key_content = nil if key_content&.empty?
    key_filepath = nil if key_filepath&.empty?

    if key_content && key_filepath
      UI.important("Both APP_STORE_CONNECT_API_KEY_CONTENT and APP_STORE_CONNECT_API_KEY_PATH are set. Preferring APP_STORE_CONNECT_API_KEY_CONTENT.")
      key_filepath = nil
    end

    if [key_id, issuer_id].any?(&:nil?) || (key_content.nil? && key_filepath.nil?)
      UI.user_error!("Missing App Store Connect API key env vars. Set APP_STORE_CONNECT_API_KEY_ID, APP_STORE_CONNECT_ISSUER_ID, and either APP_STORE_CONNECT_API_KEY_CONTENT or APP_STORE_CONNECT_API_KEY_PATH.")
    end

    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,
      key_filepath: key_filepath,
      is_key_content_base64: ENV["APP_STORE_CONNECT_API_KEY_IS_BASE64"] == "1",
      duration: 1200,
      in_house: false
    )
  end

  before_all do
    ENV["LANG"] ||= "en_US.UTF-8"
    ENV["LC_ALL"] ||= "en_US.UTF-8"
  end

  desc "Run a build sanity check (Debug, no signing concerns)"
  lane :build do
    sh(xcodegen_generate_command(repo_root))
    build_mac_app(
      project: File.join(repo_root, "Mbappe.xcodeproj"),
      scheme: "Mbappe",
      configuration: "Debug",
      skip_archive: true,
      skip_package_pkg: true,
      clean: true,
      output_directory: "build/fastlane"
    )
  end

  desc "Build a Developer ID signed release archive (.app) for direct distribution"
  lane :archive do
    sh(xcodegen_generate_command(repo_root))
    build_mac_app(
      project: File.join(repo_root, "Mbappe.xcodeproj"),
      scheme: "Mbappe",
      configuration: "Release",
      clean: true,
      export_method: "developer-id",
      export_options: {
        signingStyle: "automatic"
      },
      xcargs: "-allowProvisioningUpdates",
      export_xcargs: "-allowProvisioningUpdates",
      output_directory: "build/fastlane",
      output_name: "Mbappe"
    )
  end

  desc "Notarize the Developer ID signed app and staple the ticket"
  lane :notarize_app do
    api_key = asc_api_key
    app_path = File.join(repo_root, "build", "fastlane", "Mbappe.app")
    UI.user_error!("App not found at #{app_path}. Run `fastlane mac archive` first.") unless File.exist?(app_path)

    notarize(
      package: app_path,
      api_key: api_key,
      print_log: true
    )
    UI.success("Notarized and stapled: #{app_path}")
  end

  desc "Full release: archive + notarize + zip a distributable artifact"
  lane :release do
    archive
    notarize_app

    app_path = File.join(repo_root, "build", "fastlane", "Mbappe.app")
    zip_path = File.join(repo_root, "build", "fastlane", "Mbappe.zip")
    FileUtils.rm_f(zip_path)
    # ditto preserves code signature / notarization ticket inside the zip.
    sh("ditto -c -k --keepParent #{app_path.shellescape} #{zip_path.shellescape}")
    UI.success("Distributable archive ready: #{zip_path}")
  end
end
