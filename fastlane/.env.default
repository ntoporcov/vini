# App Store Connect API key - used by `fastlane mac notarize_app` / `release`
# for notarization via notarytool.
APP_STORE_CONNECT_API_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_API_KEY_PATH=

# Alternative to APP_STORE_CONNECT_API_KEY_PATH
APP_STORE_CONNECT_API_KEY_CONTENT=

# Set to 1 if APP_STORE_CONNECT_API_KEY_CONTENT is base64-encoded
APP_STORE_CONNECT_API_KEY_IS_BASE64=0

# Your Apple Developer Team ID (for Developer ID signing)
FASTLANE_TEAM_ID=

# GitHub release publishing. Prefer a token for the personal account that owns
# ntoporcov/vini; GH_TOKEN overrides any stored `gh auth` account.
GH_TOKEN=
GITHUB_REPOSITORY=ntoporcov/vini

# Optional release overrides. Defaults to MARKETING_VERSION in project.yml and
# tag v<version>.
VINI_RELEASE_VERSION=
VINI_RELEASE_TAG=
VINI_RELEASE_TITLE=
VINI_RELEASE_NOTES_FILE=
VINI_PRERELEASE=0

# Optional Homebrew tap update. First create ntoporcov/homebrew-vini, then set
# UPDATE_HOMEBREW_CASK=1 to write and push Casks/vini.rb.
UPDATE_HOMEBREW_CASK=0
HOMEBREW_TAP_REPO=ntoporcov/homebrew-vini
HOMEBREW_TAP_REMOTE=
HOMEBREW_TAP_PATH=
